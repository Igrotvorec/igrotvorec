# Скопируйте в .env на сервере и заполните ключ. Прокси LLM — любой OpenAI-совместимый эндпоинт, доступный серверу.
DOMAIN=igrotvorec.games
PUBLIC_URL=https://igrotvorec.games

LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_API_KEY=
SPEC_MODEL=gpt-6.1-sol
CODE_MODEL=gpt-6.1-sol
IMAGE_MODEL=gpt-image-2.5
LLM_SERVICE_TIER=priority

# Генераций, правок и автоисправлений на один IP в час (0 — без лимита).
RATE_LIMIT_PER_HOUR=30
# Одновременных операций с LLM на весь сервер.
MAX_CONCURRENT=8

# Папка с данными на хосте (игры, снимки, БД). По умолчанию ./data.
# DATA_PATH=./data
